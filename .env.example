# ============================================================
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file (secrets stay on your machine).
# ============================================================

# Admin Authentication for Private Dashboards
ADMIN_PASSWORD=admin123

# Port configuration
PORT=3000

# ------------------------------------------------------------
# Cloudflare R2 Storage (REQUIRED for product images off-site)
# ------------------------------------------------------------
# 1. Cloudflare Dashboard → R2 → Create bucket (e.g. brand-products)
# 2. R2 → Manage R2 API Tokens → Create API token
#    Permissions: Object Read & Write (and Bucket Read if listed)
# 3. Copy Access Key ID + Secret Access Key (shown once)
# 4. Account ID is in the right sidebar of any Cloudflare page
#
# Endpoint formats accepted:
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   or just the ACCOUNT_ID (32-char hex)

R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=brand-products
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key

# Optional: public URL for images (custom domain or r2.dev public bucket URL)
# Example: https://pub-xxxxx.r2.dev   or   https://images.yourdomain.com
# If empty, images are served via /api/r2/files/... from this server
R2_PUBLIC_URL=

# ------------------------------------------------------------
# Cloudflare account (also used to build R2 endpoint if needed)
# ------------------------------------------------------------
CF_ACCOUNT_ID=

# Cloudflare D1 Database (optional)
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# Backblaze B1 Backup (optional)
B1_ACCOUNT_ID=
B1_APP_KEY=
B1_BUCKET=
