# ============================================================
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file (secrets stay on your machine).
# ============================================================

# Admin Authentication for Private Dashboards
ADMIN_PASSWORD=admin123

# Port configuration
PORT=3000

# ------------------------------------------------------------
# Cloudflare R2 Storage
# Endpoint: https://4c7e187b11570938535154636504c781.r2.cloudflarestorage.com
# Bucket:   xxxx
#
# You still need R2 API token keys (local .env only):
#   Cloudflare Dashboard → R2 → Manage R2 API Tokens
# ------------------------------------------------------------

R2_ENDPOINT=https://4c7e187b11570938535154636504c781.r2.cloudflarestorage.com
R2_BUCKET=xxxx
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key

# Optional public URL for shop images (r2.dev or custom domain)
R2_PUBLIC_URL=

CF_ACCOUNT_ID=4c7e187b11570938535154636504c781

# Cloudflare D1 Database (optional)
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# Backblaze B1 Backup (optional)
B1_ACCOUNT_ID=
B1_APP_KEY=
B1_BUCKET=
