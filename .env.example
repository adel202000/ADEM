# ============================================================
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file (secrets stay on your machine).
# ============================================================

# Admin Authentication for Private Dashboards
ADMIN_PASSWORD=admin123

# Port configuration
PORT=3000

# ------------------------------------------------------------
# Cloudflare R2 Storage (REQUIRED for product images off-site)
# ------------------------------------------------------------
# Your account endpoint:
#   https://4c7e187b11570938535154636504c781.r2.cloudflarestorage.com
#
# Still need from Cloudflare Dashboard → R2 → Manage R2 API Tokens:
#   R2_ACCESS_KEY  = Access Key ID
#   R2_SECRET_KEY  = Secret Access Key
#   R2_BUCKET      = your bucket name (replace xxxx)

R2_ENDPOINT=https://4c7e187b11570938535154636504c781.r2.cloudflarestorage.com
R2_BUCKET=xxxx
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key

# Optional: public URL for images (r2.dev public bucket or custom domain)
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
R2_PUBLIC_URL=

# ------------------------------------------------------------
# Cloudflare account
# ------------------------------------------------------------
CF_ACCOUNT_ID=4c7e187b11570938535154636504c781

# Cloudflare D1 Database (optional)
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# Backblaze B1 Backup (optional)
B1_ACCOUNT_ID=
B1_APP_KEY=
B1_BUCKET=
